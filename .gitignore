# macOS Finder metadata / Karabiner auto-generated backups / Raycast exports
# (machine-specific noise, and rayconfig is a binary blob that can't be
# reviewed for leaked secrets before commit)
.DS_Store
karabiner/automatic_backups/
raycast/*.rayconfig
