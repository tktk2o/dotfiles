# gh-dash config — TEMPLATE / SEED
#
# The live config is the untracked, machine-local file `config.local.yml`
# (company-specific repo/org names live there and must NOT be committed —
# this is a public repo). setup.sh seeds config.local.yml from this file on
# first run, then symlinks it to ~/.config/gh-dash/config.yml.
#
# To add company-specific sections, edit config.local.yml (NOT this file):
#
#   - title: <team> (team)
#     filters: >-
#       is:open draft:false -author:@me
#       repo:<org>/<repo-a>
#       repo:<org>/<repo-b>
#     limit: 30

repoPaths:
  :owner/:repo: ~/src/github.com/:owner/:repo

prSections:
  - title: Review Requests
    filters: is:open review-requested:@me
    limit: 15
  - title: My Pull Requests
    filters: is:open author:@me
    limit: 15

defaults:
  preview:
    open: true
    # position: auto (default) falls back to "bottom" when
    # (screenWidth - previewWidth) < 80, so pin it to right.
    position: right
    # 0 < width < 1 is treated as a ratio of the screen width
    width: 0.5
  view: prs

keybindings:
  prs:
    #: PR の差分を新しい tmux ウィンドウで開く（hunk）
    - key: d
      command: >-
        tmux new-window -n "diff #{{.PrNumber}}"
        'gh pr diff {{.PrNumber}} -R {{.RepoName}} | hunk patch'
    # overrides the built-in refreshAll (r still refreshes the current section)
    # left pane: claude /review, right pane: the same diff as `d`
    #: PR レビューを開始する（claude /review + 差分ペイン）
    - key: R
      command: >-
        tmux new-window -n "review #{{.PrNumber}}" -c {{.RepoPath}}
        'claude "/review https://github.com/{{.RepoName}}/pull/{{.PrNumber}}"'
        \; split-window -h -d -c {{.RepoPath}}
        'gh pr diff {{.PrNumber}} -R {{.RepoName}} | hunk patch'
    #: PR をブラウザで開く
    - key: o
      command: gh pr view --web {{.PrNumber}} -R {{.RepoName}}
    #: PR を squash マージする
    - key: m
      command: gh pr merge {{.PrNumber}} --squash -R {{.RepoName}}
    #: PR を approve する
    - key: a
      command: gh pr review {{.PrNumber}} --approve -R {{.RepoName}}

theme:
  colors:
    text:
      primary: "#f8f8f2"
      secondary: "#6272a4"
    background:
      selected: "#44475a"
    border:
      primary: "#bd93f9"
